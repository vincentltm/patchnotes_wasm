all: ../js/cards/wasm/patchnotes_cards.js

../js/cards/wasm/patchnotes_cards.js: $(OBJECTS)
	@mkdir -p ../js/cards/wasm
	$(CXX) $(WASM_FLAGS) --embed-file build_wasm/res@/res $(OBJECTS) -o ../js/cards/wasm/patchnotes_cards.js

build_wasm/WasmCardBridge.o: src/WasmCardBridge.cpp
	@mkdir -p build_wasm
	$(CXX) $(WASM_FLAGS) -c src/WasmCardBridge.cpp -o build_wasm/WasmCardBridge.o

build_wasm/cards/CardRegistry.o: ../../../Workshop_Computer_VCV/src/cards/CardRegistry.cpp
